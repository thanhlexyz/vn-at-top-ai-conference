{{ define "main" -}}
{{ .Content }}
{{- /* A plain GET form: GitHub's /issues/new page reads `title` and `body` from the address, so no script is needed. */}}
<form class="feedback" action="https://github.com/{{ site.Params.repository }}/issues/new" method="get">
	<label for="title">{{ T "fb_title" }}</label>
	<input id="title" name="title" type="text" required maxlength="200" placeholder="{{ T "fb_title_placeholder" }}">
	<label for="body">{{ T "fb_details" }}</label>
	<textarea id="body" name="body" rows="10" required placeholder="{{ T "fb_details_placeholder" }}"></textarea>
	<button type="submit">{{ T "fb_submit" }}</button>
</form>
<p class="note">{{ T "fb_note" (printf "https://github.com/%s/issues" site.Params.repository) | safeHTML }}</p>
{{- end }}
